variant: fcos
version: 1.7.0
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: homelab-pihole

ignition:
  config:
    merge:
    - source: http://192.168.64.1:8000/ignition/setup_data_disk.ign
    - source: http://192.168.64.1:8000/ignition/setup_ansible_user.ign