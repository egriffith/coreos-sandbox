variant: fcos
version: 1.7.0
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: homelab-pihole

ignition:
  config:
    merge:
    - source: https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/main/ignition/setup_data_disk.ign
    - source: https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/main/ignition/setup_ansible_user.ign