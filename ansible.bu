variant: fcos
version: 1.7.0
passwd:
  users:
    - name: ansible
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINqoV+Hn3t08WXPE4N8wovztdXJUxmF56NNYTkb5lp6h

storage:
  files:
    - path: /etc/sudoers.d/ansible
      mode: 0440
      contents:
        inline: |
          ansible ALL=(ALL) NOPASSWD:ALL