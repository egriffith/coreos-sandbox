variant: fcos
version: 1.7.0
systemd:
  units:
    - name: podman-auto-update.timer
      enabled: true

storage:
  files:
    - path: /etc/containers/systemd/httpd.container
      contents:
        inline: |
          [Unit]
          Description=Httpd Service
          Wants=network-online.target
          After=network-online.target

          [Container]
          ContainerName=apache-hello-world
          Image=docker.io/library/httpd:alpi

          AutoUpdate=registry
          Label=app=httpd

          RunInit=true
          PublishPort=8080:80

          [Service]
          Restart=always
          TimeoutStartSec=infinity

          [Install]
          WantedBy=multi-user.target
          WantedBy=default.target