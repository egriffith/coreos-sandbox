{
  "ignition": {
    "version": "3.6.0"
  },
  "storage": {
    "files": [
      {
        "path": "/etc/containers/systemd/httpd.container",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        }
      },
      {
        "path": "/etc/containers/systemd/httpd.pod",
        "contents": {
          "compression": "",
          "source": "data:,%5BPod%5D%0APublishPort%3D8080%3A80"
        }
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "enabled": true,
        "name": "podman-auto-update.timer"
      }
    ]
  }
}
