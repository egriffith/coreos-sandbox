variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      password_hash: $y$j9T$4XCbjNhq32PfMZYL2mK5W1$CVfKJJiTYgrtyx93rmMTAEoNZv6mKaLLjr5vLKS3C08
storage:
  files:
    - path: /opt/file
      contents:
        inline: Hello, world!
      mode: 0644
      user:
        id: 500
      group:
        id: 501
systemd:
  units:
    - name: hello.service
      enabled: true
      contents: |
        [Unit]
        Description=A hello world unit!
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/echo "Hello, World!"
        [Install]
        WantedBy=multi-user.target
