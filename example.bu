variant: fcos
version: 1.7.0
ignition:
  config:
    merge:
    - source: https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/users.ign
    - source: https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/updates.ign
    - source: https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/apache-hello-world.ign

systemd:
  units:
    - name: hello.service
      enabled: true
      contents: |
        [Unit]
        Description=A hello world unit!
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/echo "Hello, World!"
        [Install]
        WantedBy=multi-user.target
