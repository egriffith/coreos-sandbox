{
  "ignition": {
    "config": {
      "merge": [
        {
          "source": "https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/main/ignition/setup_data_disk.ign"
        },
        {
          "source": "https://raw.githubusercontent.com/egriffith/coreos-sandbox/refs/heads/main/ignition/setup_ansible_support.ign"
        }
      ]
    },
    "version": "3.6.0"
  },
  "storage": {
    "files": [
      {
        "overwrite": true,
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,homelab-pihole"
        },
        "mode": 420
      }
    ]
  }
}
